# Dispatcharr configuration
# Edit this file then run: sudo systemctl restart dispatcharr

# Web UI port
DISPATCHARR_PORT=9191

# Internal service ports (change only if 9191/15432/16379 conflict with other apps)
POSTGRES_PORT=15432
REDIS_PORT=16379
DAPHNE_PORT=18001
UWSGI_HTTP_PORT=5656

# Database credentials
POSTGRES_USER=dispatcharr
POSTGRES_DB=dispatcharr
POSTGRES_PASSWORD=dispatcharr

# Data directory (where recordings, uploads, logos, etc. are stored)
DISPATCHARR_DATA_DIR=/opt/dispatcharr/data

# Logging level: DEBUG, INFO, WARNING, ERROR
DISPATCHARR_LOG_LEVEL=INFO

# Process priorities (lower = higher priority; 0-19 range)
CELERY_NICE_LEVEL=5
UWSGI_NICE_LEVEL=0
