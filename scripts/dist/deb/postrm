#!/bin/bash
# dpkg post-removal script. Runs AFTER dpkg removes package files.
#
# purge   Delete /opt/dispatcharr entirely (user data included) and reload systemd.
# remove  Reload systemd to drop the now-absent unit file.
set -e

case "$1" in
  purge)
    rm -rf /opt/dispatcharr
    [ -d /run/systemd/system ] && systemctl daemon-reload 2>/dev/null || true
    ;;
  remove)
    [ -d /run/systemd/system ] && systemctl daemon-reload 2>/dev/null || true
    ;;
esac
